{
  "extends": ["@total-typescript/tsconfig/bundler/dom/app", "astro/tsconfigs/base"],
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "components/*": ["./src/components/*"],
      "data/*": ["./src/data/*"],
      "layouts/*": ["./src/layouts/*"],
      "styles/*": ["./src/styles/*"],
      "utils/*": ["./src/utils/*"]
    }
  }
}
