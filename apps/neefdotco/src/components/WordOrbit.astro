---
import { shuffleAndBalanceRings } from "utils/shuffleAndBalanceRings";

interface Props {
  words: string[];
  "aria-hidden"?: "true" | "false";
}

const { words, "aria-hidden": ariahidden } = Astro.props;

const rings = shuffleAndBalanceRings(words);
---

<div
  class="system"
  data-gravity-well="dormant"
  aria-hidden={ariahidden ?? "false"}
  style="display: none;"
>
  {rings.map((ring) => (
    <div>
      <ul>
        {ring.map((word) => (
          <li>{word}</li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  div.system {
    position: fixed;
    z-index: -1;

    --bottom: 12vh;
    bottom: clamp(50px, var(--bottom), 180px);
    right: clamp(25px, 8vw, 150px);
    transform: rotate(-10deg);

    @media ((height <= 940px) and (width <= 767px)) or (height <= 700px) {
      --bottom: 8vh;
      opacity: 0.37;
    }

    /* This `div` needed as well as the `ul` since there are transforms that would clash when placed on the same element */
    > div {
      --ring-index: calc(sibling-count() + 1 - sibling-index());
      --transition-delay: calc(100ms + 300ms * sibling-index());
      --transition-top-duration: 1000ms;
      --transition-top-easing: cubic-bezier(0, 0.9, 0.1, 1);
      --hidden-top: 20vh;
      --hidden-opacity: 0;

      transition:
        transform 1000ms ease 100ms,
        opacity 400ms ease var(--transition-delay),
        translate var(--transition-top-duration) var(--transition-top-easing)
        var(--transition-delay),
        rotate calc(700ms * var(--ring-index)) cubic-bezier(0, 0, 0.2, 1);

      @starting-style {
        translate: 0 var(--hidden-top);
        opacity: var(--hidden-opacity);
      }

      > ul {
        transform-style: preserve-3d;
        rotate: x -100deg;
        --spin-duration: 540s;
        animation: spin var(--spin-duration) linear infinite;

        > li {
          position: absolute;
          top: 50%;
          left: 50%;
          padding: 0 4px;
          line-height: 1.3;
          width: max-content;
          user-select: none;
          background-color: var(--mixed-text-background);
          color: var(--text-color);
          --ring-position: calc((sibling-index() - 1) / sibling-count());
          --word-gap: calc(clamp(250px, 25vw, 600px) * pi / 5);
          --r: calc(sibling-count() * var(--word-gap) / (2 * pi));
          --a: calc(var(--ring-position) * 360deg);
          transform: translateX(-50%) rotateZ(var(--a)) translateY(var(--r)) rotateX(90deg);
          animation: var(--hide-half, none) var(--spin-duration) step-end infinite;
          animation-delay: calc(
            var(--spin-duration) *
            (var(--ring-position) - 1 - var(--layer-phase, 0))
          );
          transition: background-color var(--color-transition);
        }
      }
    }

    /* After layering by JS */
    &[data-layer] {
      --hide-half: hide-half; /* Hide half of each system */
      &[data-layer="front"] {
        --layer-phase: 0.5; /* half a spin out of phase with the rear layer */
      }
    }

    @media (pointer: fine) {
      &:hover,
      &:hover + &,
      &:has(+ &:hover) {
        --rotateZ: 5deg;
        li:hover::after {
          content: "";
          position: absolute;
          inset: -8px; /* Extra hitbox around the word, so the rotation doesn't immediately end the hover */
        }
      }
      &:active,
      &:active + &,
      &:has(+ &:active) {
        --rotateZ: 10deg;
      }

      > div {
        transform: rotateZ(calc(var(--rotateZ, 0deg) * pow(-1, sibling-index() + 1)));

        ul > li:hover {
          background-color: var(--opposite-mode-background);
          color: var(--background-color);
        }
      }
    }
  }

  @keyframes spin {
    to {
      transform: rotate(-360deg);
    }
  }

  :global(body[data-exiting="true"]) .system > div {
    translate: 0 var(--hidden-top);
    opacity: var(--hidden-opacity);
    --transition-delay: calc(150ms * (sibling-index() - 1));
    --transition-top-duration: 400ms;
    --transition-top-easing: cubic-bezier(0.9, 0, 0.6, 1);
  }

  /* Once the gravity well has captured the cursor */
  :global(body:has(#user-cursor[size="xxxl"])) {
    .system[data-layer="rear"] {
      z-index: -2; /* The rear layer drops behind the cursor */
    }
    #user-cursor {
      pointer-events: auto; /* Also block hover interactions on words */
    }
  }

  @keyframes hide-half {
    25% {
      visibility: hidden;
    }
    75% {
      visibility: visible;
    }
  }
</style>

<script>
  import { shuffleAndBalanceRings } from "utils/shuffleAndBalanceRings";

  import { throttle } from "@repo/utils/throttle";

  const system = document.querySelector<HTMLElement>(".system");
  if (!system) {
    throw new Error("WordOrbit requires a .system element");
  }

  const words = system.querySelectorAll("li");
  const arrangement = shuffleAndBalanceRings([...words].map((li) => li.textContent ?? "")).flat();
  words.forEach((li, i) => {
    li.textContent = arrangement[i] ?? "";
  });

  if (matchMedia("(pointer:fine)").matches) {
    // Add the rear layer, a copy of the front (before it, as the hover selectors expect)
    const rearLayer = system.cloneNode(true) as HTMLElement;
    rearLayer.dataset.layer = "rear";
    rearLayer.ariaHidden = "true";
    rearLayer.removeAttribute("data-gravity-well");
    system.dataset.layer = "front";
    system.before(rearLayer);
    rearLayer.style.display = "block";
  }

  system.style.display = "block";

  const rings = document.querySelectorAll<HTMLElement>(".system > div");

  // only pull cursor once rings have ~completed their transitions
  setTimeout(() => (system.dataset.gravityWell = "active"), 400 + system.children.length * 300);

  if ("ontouchstart" in document.documentElement && "DeviceOrientationEvent" in window) {
    interface iOSDeviceOrientationEvent extends DeviceOrientationEvent {
      requestPermission?: () => Promise<"granted" | "denied">;
    }
    const DOE = DeviceOrientationEvent as unknown as iOSDeviceOrientationEvent;

    const orbiters = document.querySelectorAll<HTMLElement>(".system li");
    const tiltOrbit = throttle((e: DeviceOrientationEvent) => {
      const tilt = window.innerHeight > window.innerWidth ? e.gamma : e.beta;
      rings.forEach((ring) => {
        ring.style.rotate = `${tilt}deg`;
      });
    }, 41); // ~24fps

    let ac: AbortController | undefined;
    orbiters.forEach((object) => {
      object.addEventListener("click", async () => {
        if (ac && !ac.signal.aborted) {
          ac.abort();
          rings.forEach((ring) => {
            ring.style.rotate = "";
          });
          return;
        }

        // iOS needs explicit permission (a noop if already granted); other devices don't have this method
        if ((await DOE.requestPermission?.()) === "denied") {
          return;
        }
        ac = new AbortController();
        window.addEventListener("deviceorientation", tiltOrbit, { signal: ac.signal });
      });
    });
  }
</script>
