---
interface Props {
  /** An array of 60 words */
  words: string[];
  "aria-hidden"?: "true" | "false";
}

const { words, "aria-hidden": ariahidden } = Astro.props;

/*
  Circumference = 2 * PI * r, so doubling the radius also doubles the circumference, i.e. each
  concentric ring should increase in word count by the number of words of the smallest ring.
*/
const OUTER_CIRCLE_WORD_COUNT = 30;
const MIDDLE_CIRCLE_WORD_COUNT = 20;
const INNER_CIRCLE_WORD_COUNT = 10;

const OUTER_CIRCLE = words.splice(0, OUTER_CIRCLE_WORD_COUNT);
const MIDDLE_CIRCLE = words.splice(0, MIDDLE_CIRCLE_WORD_COUNT);
const INNER_CIRCLE = words.splice(0, INNER_CIRCLE_WORD_COUNT);
---

{/*
  Rendered twice so the user's cursor (z-index: -1) can sit _between_ its rear and front halves,
  since z-index can't interleave elements between `.system`'s' stacking contexts.
*/}
{(["rear", "front"] as const).map((layer) => (
  <div
    class="system"
    data-layer={layer}
    data-cursor-gravity-well={layer === "front" ? "dormant" : undefined}
    aria-hidden={layer === "rear" ? "true" : (ariahidden ?? "false")}
  >
    {[OUTER_CIRCLE, MIDDLE_CIRCLE, INNER_CIRCLE].map((circle) => (
      <div>
        <ul>
          {circle.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    ))}
  </div>
))}

<style>
  @property --ring-index {
    syntax: "<number>";
    inherits: true; /* Ensures that sibling-index() is not resolved in the context of the element that reads it */
    initial-value: 1;
  }

  div.system {
    position: fixed;
    z-index: 0;
    user-select: none;

    &[data-layer="front"] {
      --layer-phase: 0.5; /* half a spin out of phase with the rear layer */
    }

    --bottom: 12vh;
    bottom: clamp(50px, var(--bottom), 180px);
    right: clamp(25px, 8vw, 150px);
    transform: rotate(-10deg);

    @media ((height <= 940px) and (width <= 767px)) or (height <= 700px) {
      --bottom: 8vh;
      opacity: 0.37;
    }

    > div {
      --ring-index: calc(sibling-count() + 1 - sibling-index());
      --transition-delay: calc(100ms + 300ms * sibling-index());
      --transition-top-duration: 1000ms;
      --transition-top-easing: cubic-bezier(0, 0.9, 0.1, 1);
      --hidden-top: 20vh;
      --hidden-opacity: 0;

      transition:
        transform 1000ms ease 100ms, /* small delay to avoid flickering when we stop hovering as it rotates */
        opacity 400ms ease var(--transition-delay),
        translate var(--transition-top-duration) var(--transition-top-easing) var(--transition-delay),
        rotate calc(700ms * var(--ring-index)) cubic-bezier(0, 0, 0.2, 1);

      @starting-style {
        translate: 0 var(--hidden-top);
        opacity: var(--hidden-opacity);
      }

      > ul {
        position: relative;
        transform-style: preserve-3d;
        rotate: x -100deg;
        --spin-duration: 540s;
        animation: spin var(--spin-duration) linear infinite;

        > li {
          position: absolute;
          top: 50%;
          left: 50%;
          padding: 0 4px;
          line-height: 1.3;
          width: max-content;
          background-color: var(--mixed-text-background);
          color: var(--text-color);
          --ring-position: calc((sibling-index() - 1) / sibling-count()); /* how far round the ring, 0 to <1 */
          --r: calc(var(--ring-index) * clamp(250px, 25vw, 600px));
          --a: calc(var(--ring-position) * 360deg);
          transform: translateX(-50%) rotateZ(var(--a)) translateY(var(--r)) rotateX(90deg);
          animation: hide-half var(--spin-duration) step-end infinite;
          animation-delay: calc(var(--spin-duration) * (var(--ring-position) - 1 - var(--layer-phase, 0)));
        }
      }
    }

    @media (pointer: fine) {
      &:hover, &:hover + &, &:has(+ &:hover) {
        --rotateZ: 5deg;
      }
      &:active, &:active + &, &:has(+ &:active) {
        --rotateZ: 10deg;
      }

      > div {
        transform: rotateZ(calc(var(--rotateZ, 0deg) * pow(-1, sibling-index() + 1)));

        ul > li:hover {
          background-color: var(--opposite-mode-background);
          color: var(--background-color);
        }
      }
    }
  }

  :global(body[data-exiting="true"]) .system > div {
    translate: 0 var(--hidden-top);
    opacity: var(--hidden-opacity);
    --transition-delay: calc(150ms * (sibling-index() - 1));
    --transition-top-duration: 400ms;
    --transition-top-easing: cubic-bezier(0.9, 0, 0.6, 1);
  }

  /*
    The rear layer only drops behind the cursor once the gravity well has captured it.
    Otherwise it sits level with the front layer, always above the cursor.
  */
  :global(body:has(#user-cursor[size="xxxl"])) {
    #user-cursor {
      pointer-events: auto; /* Also block hover interactions on words */
    }
    div.system[data-layer="rear"] {
      z-index: -2;
    }
  }

  @keyframes hide-half {
    25% { visibility: hidden; }
    75% { visibility: visible; }
  }

  @keyframes spin {
    to { transform: rotate(-360deg); }
  }
</style>

<script>
  import { throttle } from "@repo/utils/throttle";

  const rings = document.querySelectorAll<HTMLElement>(".system > div");

  // only pull cursor once rings have ~completed their transitions
  const system = document.querySelector<HTMLElement>(".system[data-layer='front']")!;
  setTimeout(() => (system.dataset.cursorGravityWell = "active"), 400 + system.children.length * 300);

  if ("ontouchstart" in document.documentElement && "DeviceOrientationEvent" in window) {
    interface iOSDeviceOrientationEvent extends DeviceOrientationEvent {
      requestPermission?: () => Promise<"granted" | "denied">;
    }
    const DOE = DeviceOrientationEvent as unknown as iOSDeviceOrientationEvent;

    const orbiters = document.querySelectorAll<HTMLElement>(".system li");
    const tiltOrbit = throttle((e: DeviceOrientationEvent) => {
      const tilt = window.innerHeight > window.innerWidth ? e.gamma : e.beta;
      rings.forEach(ring => (ring.style.rotate = `${tilt}deg`));
    }, 41); // ~24fps

    let ac: AbortController | undefined;
    orbiters.forEach(object => {
      object.addEventListener("click", async () => {
        if (ac && !ac.signal.aborted) {
          ac.abort();
          rings.forEach(ring => (ring.style.rotate = ""));
          return;
        }

        // iOS needs explicit permission (a noop if already granted); other devices don't have this method
        if ((await DOE.requestPermission?.()) === "denied") {
          return;
        }
        ac = new AbortController();
        window.addEventListener("deviceorientation", tiltOrbit, { signal: ac.signal });
      });
    });
  }
</script>
