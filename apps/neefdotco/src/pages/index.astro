---
import ExternalLink from "components/ExternalLink.astro";
import WordOrbit from "components/WordOrbit.astro";
import { SKILLS } from "data/skills";
import Layout from "layouts/Layout.astro";
---

<Layout>
  <div>
    <div id="info">
      <section>
        <p>
          Neef Rehman is an Engineering manager, Full-stack Engineer and Interaction Designer based in London.
          Currently he works at <ExternalLink href="https://isometric.com">Isometric</ExternalLink>, leading
          teams building measurement and verification systems for carbon removal.
        </p>
        <div>
          <button data-more-info-show="previously" data-cursor-contents="+">Previously</button>
          —
          <button data-more-info-show="speaking" data-cursor-contents="+">Speaking</button>
          —
          <button data-more-info-show="education" data-cursor-contents="+">Teaching</button>
        </div>
        <footer>
          <ExternalLink href="https://twitter.com/neefrehman_">Twitter</ExternalLink>
          —
          <ExternalLink href="https://github.com/neefrehman">GitHub</ExternalLink>
          —
          <ExternalLink href="https://www.linkedin.com/in/neefrehman/">LinkedIn</ExternalLink>
        </footer>
      </section>

      <div
        id="more-info-live-region"
        aria-live="polite"
      >
      </div>
    </div>

    <!--
      The user selectable info sections will move from here, to the live region above, when the 
      [data-more-info-show] buttons above are clicked. It's a little unorthodox, but AFAICT
      the a11y of this interaction is good, due to the aria attributes used. It would be nice
      to achieve the same layout with details/summary elements (or similar), but I can't see
      how without having to jump through a different set of hoops (yet!)
    -->
    <div id="more-info-hidden-region" aria-hidden="true">
      <section id="previously">
        <h2>Previously</h2>
        <ol>
          <li>
            <span>Full-stack Engineer</span>
            <span><ExternalLink href="https://ustwo.com">ustwo</ExternalLink></span>
          </li>
          <li>
            <span>Venture Lead</span>
            <span><ExternalLink href="https://adventure.ustwo.com">ustwo Adventure</ExternalLink></span>
          </li>
          <li>
            <span>Bioinformatics</span>
            <span><ExternalLink href="https://www.illumina.com/">Illumina</ExternalLink></span>
          </li>
          <li>
            <span>Degree</span>
            <span><ExternalLink href="https://wikipedia.org/wiki/Physics">Physics</ExternalLink></span>
          </li>
          <li>
            <span>Head barista</span>
            <span><ExternalLink href="https://genesiscinema.co.uk">Genesis Cinema</ExternalLink></span>
          </li>
        </ol>
      </section>

      <section id="speaking">
        <h2>Speaking</h2>
        <ul>
          <li>
            <span><ExternalLink href="https://leaddev.com/leadership/how-to-zoom-out-and-when-to-stop">How to Zoom Out</ExternalLink></span>
            <span>LeadDev/LDX3</span>
          </li>
          <li>
            <span><ExternalLink href="https://videos.theconference.se/neef-rehman-machine-forgetting">Machine Forgetting</ExternalLink></span>
            <span>The Conference</span>
          </li>
          <li>
            <span>Notes on Determinism</span>
            <span>London Design Festival</span>
          </li>
          <li>
            <span>Notes on Determinism</span>
            <span>Birmingham Design Festival</span>
          </li>
          <li>
            <span>Rubber Duck Everything</span>
            <span>West of England Design Forum</span>
          </li>
        </ul>
      </section>

      <section id="education">
        <h2>Teaching</h2>
        <ul>
          <li>
            <span>Guest lecturer</span>
            <span>D&AD New Blood Academy</span>
          </li>
          <li>
            <span>Guest lecturer</span>
            <span>UAL:CCI</span>
          </li>
          <li>
            <span>Guest lecturer</span>
            <span>Hyper Island</span>
          </li>
          <li>
            <span>Module Facilitator</span>
            <span>Falmouth University</span>
          </li>
        </ul>
      </section>
    </div>

    <WordOrbit words={SKILLS.slice()} />
  </div>
</Layout>

<style>
  #info > *,
  #more-info-live-region > section {
    display: flex;
    flex-direction: column;
    gap: 0.85em;
    text-align: justify;
  }

  #info {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem;
    margin-block: 3rem;

    > * {
      grid-column: span 12;

      [data-more-info-show][aria-current="true"] {
        text-decoration: none;
      }
    }

    #more-info-live-region {
      > section li {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 2rem;

        > span:first-child {
          text-align: left;
        }

        > span:last-child {
          flex: 1;
          text-align: right;
        }
      }
    }

    @media (width >= 48rem) {
      margin-top: max(5em, 80px);

      > * {
        grid-column: span 6;
      }
    }

    @media (width >= 1440px) {
      > * {
        grid-column: span 4;
      }
    }
  }

  #more-info-hidden-region {
    display: none;
  }
</style>

<script>
  const moreInfoLiveRegion = document.querySelector("#more-info-live-region");
  const moreInfoHiddenRegion = document.querySelector("#more-info-hidden-region");
  const moreInfoButtons = document.querySelectorAll<HTMLButtonElement>("[data-more-info-show]");

  moreInfoButtons.forEach(button => {
    // We move elements around instead of copying them, so that their event listeners can come along for the ride
    button.addEventListener("click", () => {
      const associatedElement = document.querySelector(`#${button.dataset.moreInfoShow}`);

      if (!associatedElement) {
        return;
      }

      const isOpening = button.ariaCurrent !== "true";
      moreInfoHiddenRegion?.append(...(moreInfoLiveRegion?.children ?? []));
      if (isOpening) {
        moreInfoLiveRegion?.replaceChildren(associatedElement);
      }

      moreInfoButtons.forEach(other => {
        const isCurrent = isOpening && other === button;
        other.ariaCurrent = String(isCurrent);
        other.dataset.cursorContents = isCurrent ? "-" : "+";
      });
    });
  });
</script>
