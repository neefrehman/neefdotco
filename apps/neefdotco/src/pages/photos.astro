---
import { Picture } from "astro:assets";

import quantisedColorMap from "../data/quantized-photo-colors.json";
import Layout from "../layouts/Layout.astro";

const images = import.meta.glob<ImageMetadata>("../photos/large/*.jpg", {
  eager: true,
  import: "default",
});

const photos = Object.entries(images).map(([path, src]) => ({
  src,
  keyColor:
    (quantisedColorMap as Record<string, string>)[path.split("/").pop()!] ??
    "var(--opposite-mode-background)",
}));

const spacerElementList = [...Array(Math.ceil(photos.length * 0.4))];
---

<Layout
  title="Photos — Neef Rehman"
  description="Photography by Neef Rehman, a Creative Technologist and full-stack engineer"
  metaImageUrl="https://neef.co/images/meta-image-photos.png"
>
  <div class="photo-container">
    {
      photos.map(photo => (
        <Picture
          src={photo.src}
          pictureAttributes={{ style: `--photo-key-color: ${photo.keyColor}` }}
          alt=""
          widths={[640, 768, 1024, 1600, 1920]}
          formats={["avif", "webp"]}
        />
      ))
    }
    {spacerElementList.map(() => <div class="spacer" />)}
  </div>
</Layout>

<style>
  .photo-container {
    .spacer {
      pointer-events: none;
    }

    margin: 10px;
    margin-top: -100px;
    padding-bottom: 80px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-around;
    row-gap: clamp(100px, 20vw, 200px);
    column-gap: clamp(50px, 12vw, 120px);

    :is(picture, .spacer) {
      --width: clamp(280px + var(--y), 280px + var(--y) + 2.5vw, 370px + var(--y));
      --height: clamp(227px + var(--x), 227px + var(--x) + 2.5vw, 300px + var(--x));
      --scale: 1;
      width: calc(var(--width) * var(--scale));
      height: calc(var(--height) * var(--scale));
    }

    picture {
      background-color: var(--photo-key-color);
      filter: contrast(90%);
      overflow-y: hidden;
      position: relative;
      cursor: crosshair;
      border: 0;
      --translate-x: clamp(var(--x) * 0.5, var(--x) + 7vw, var(--x) * 0.8);
      --translate-y: clamp(var(--y) * 0.5, var(--y) + 7vw, var(--y) * 1.3);
      --hidden-translate: var(--translate-x) calc(var(--translate-y) + 33% + var(--y));
      --hidden-transition: translate 1300ms cubic-bezier(0, 0.9, 0.1, 1);
      translate: var(--translate-x) var(--translate-y);
      transition: translate 2100ms cubic-bezier(0, 0.9, 0.1, 1);

      &:not(.initial-loaded) {
        /* Prevents the browser from loading images that are at the top of the page, before we shuffle them */
        display: none;
      }
    
      &:first-child {
        margin-left: clamp(40px, 7vw, 100px);
      }
    
      &:hover {
        z-index: 2;
        filter: contrast(88%) brightness(105%);
      }
    
      &.zoom {
        --scale: 2.5;
      }
    
      &:not(.loaded) {
        translate: var(--hidden-translate);
        transition: var(--hidden-transition);

        &::after {
          scale: 1;
        }
      }
    
      &::after {
        content: "";
        display: block;
        background-color: var(--photo-key-color);
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        scale: 1 0;
        transform-origin: bottom;
        transition: scale 300ms cubic-bezier(0.9, 0, 0.6, 1);
      }
    }
  
    @media (width <= 575px) {
      .spacer {
        height: 0;
      }
  
      picture {
        &.zoom {
          --scale: 1.5;
        }
    
        --hidden-translate: var(--translate-x) calc((var(--translate-y) + 33% + var(--y)) * 0.5);
      }
    }
  }

  :global(body[data-exiting="true"]) .photo-container picture {
    --exit-delay: calc(min(sibling-index(), 12) * 60ms);
    translate: var(--hidden-translate);
    transition: var(--hidden-transition) var(--exit-delay);

    &::after {
      scale: 1;
      transition-delay: var(--exit-delay);
    }
  }
</style>

<script>
  import { shuffle } from "@repo/utils/math/shuffle";

  const photoContainer = document.querySelector(".photo-container")!;

  const getRandomOffset = () => 10 * Math.floor(Math.random() * 9) - 40;

  const shuffledChildren = shuffle(Array.from(photoContainer.querySelectorAll<HTMLElement>(":scope > *")));
  shuffledChildren.forEach(el => {
    el.style.setProperty("--x", `${getRandomOffset()}px`);
    el.style.setProperty("--y", `${getRandomOffset()}px`);
    el.classList.add("initial-loaded");
  });
  photoContainer.replaceChildren(...shuffledChildren);

  let loadedPhotoCount = 0;
  shuffledChildren.filter(el => el.matches("picture")).forEach((photo, i) => {
    const imageElement = photo.querySelector<HTMLImageElement>("img")!;
    if (i < 3) {
      imageElement.fetchPriority = "high";
    }

    imageElement.addEventListener("load", () => {
      loadedPhotoCount++; // delay the transition so they don't all load at the same time (for cached images)
      setTimeout(() => photo.classList.add("loaded"), 200 + loadedPhotoCount * 30);
    });

    photo.addEventListener("click", () => {
      photo.classList.toggle("zoom");
      const siblings = [...shuffledChildren].filter(sibling => sibling !== photo);
      siblings.forEach(sibling => sibling.classList.remove("zoom"));
    });
  });
</script>
