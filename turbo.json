{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": ["biome.json", ".prettierrc.json"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": false,
      "outputs": []
    }
  }
}
